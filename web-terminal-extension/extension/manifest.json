{
  "manifest_version": 3,
  "name": "Web Terminal Injector",
  "version": "1.0.0",
  "description": "Injects a local terminal into any website.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "ws://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": [
        "lib/xterm.css",
        "content.css"
      ],
      "js": [
        "lib/xterm.js",
        "lib/xterm-addon-fit.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Web Terminal Settings",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
